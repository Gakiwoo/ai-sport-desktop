{
  "name": "ai-sport-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build:windows": "node scripts/build-windows.mjs",
    "tauri:signer": "npx tauri signer generate --write-keys src-tauri/updater.key --ci",
    "tauri:icons": "npx tauri icon icons/Gakiwoo.png",
    "setup:mediapipe": "node scripts/setup-mediapipe.mjs",
    "prebuild": "npm run setup:mediapipe",
    "lint": "eslint src --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "check": "npm run lint && npm run format:check && tsc --noEmit && npm run test"
  },
  "dependencies": {
    "@ai-sport/core": "file:../packages/ai-sport-core",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^6.30.4",
    "react-router-dom": "^6.30.4",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "minimatch@3.1.5": {
      "brace-expansion": "^1.1.18"
    },
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23",
    "undici": "^7.28.1"
  }
}
